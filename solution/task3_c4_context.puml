@startuml
!include <C4/C4_Context>

title C4 Level 1 — Диаграмма контекста: Онлайн-открытие депозитов (MVP)

Person(p_new, "Новый клиент", "Физическое лицо")
Person(p_exist, "Существующий клиент", "Физическое лицо")
Person(p_cc, "Оператор кол-центра", "Банковский кол-центр")
Person(p_back, "Менеджер бэк-офиса", "Депозитные продукты")

System_Boundary(bank, "Банк «Стандарт»") {
    System(sys, "Онлайн-открытие депозитов (MVP)", "Приём и обработка заявок на депозит/накопительный счёт, централизованные ставки, СМС-уведомления")
}

System_Ext(ext_cc, "Система кол-центра", "React.js / Java Spring Boot / PostgreSQL")
System_Ext(ext_sms, "СМС-шлюз → Телеком-оператор", "Внешний канал отправки СМС")

Rel(p_new, sys, "Подаёт заявку на депозит (телефон, Ф.И.О.) через Сайт", "HTTPS")
Rel(p_exist, sys, "Подаёт заявку (счёт, сумма) через Интернет-банк, подтверждает СМС-кодом", "HTTPS")
Rel(p_cc, sys, "Получает заявки с сайта, консультирует клиента")
Rel(p_back, sys, "Обрабатывает заявку, подтверждает условия в АБС")
Rel(sys, ext_cc, "Передаёт заявку с сайта менеджеру кол-центра", "API")
Rel(sys, ext_sms, "Отправляет СМС-уведомления (подтверждение ставки, открытие депозита)")

@enduml
