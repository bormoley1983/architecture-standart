@startuml
!include <C4/C4_Context>

title C4 Level 1 — Диаграмма контекста: Передача ставок в кол-центры (MVP)

Person(p_op_bank, "Оператор банковского кол-центра", "Банковский кол-центр")
Person(p_op_part, "Оператор партнёрского кол-центра", "Партнёрский кол-центр (внешняя компания)")
Person(p_back, "Менеджер бэк-офиса", "Депозитные продукты")

System_Boundary(bank, "Банк «Стандарт»") {
    System(sys, "Передача депозитных ставок в кол-центры", "Актуальные ставки для операторов банковского и партнёрского кол-центра")
}

System_Ext(ext_bankcc, "Система банковского кол-центра", "React.js / Java Spring Boot / PostgreSQL")
System_Ext(ext_partcc, "Система партнёрского кол-центра", "Внешняя система, другая компания")

Rel(p_op_bank, sys, "Видит актуальные ставки при консультировании клиента")
Rel(p_op_part, sys, "Консультирует по ставкам (из загруженного файла)")
Rel(p_back, sys, "Обновляет ставки (заменяет Excel)")
Rel(sys, ext_bankcc, "Предоставляет актуальные ставки", "", API)
Rel(sys, ext_partcc, "Передаёт актуальные ставки в виде файла (CSV/XML)")

@enduml
